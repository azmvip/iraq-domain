<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/grey_100"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ═══ HEADER ═══ -->
        <LinearLayout
            android:id="@+id/headerCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/header_gradient"
            android:paddingTop="18dp"
            android:paddingBottom="16dp">

            <!-- Title row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <!-- App icon in header -->
                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/hero_card_bg">
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_download"
                        android:contentDescription="RedLoad" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RedLoad"
                        android:textColor="@color/white"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/cairo" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="تنزيل فيديوهات تيك توك بدون علامة مائية"
                        android:textColor="@color/white"
                        android:alpha="0.85"
                        android:textSize="12sp"
                        android:fontFamily="@font/cairo" />
                </LinearLayout>
            </LinearLayout>

            <!-- Feature pills -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/hero_card_bg"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_bolt"
                        android:contentDescription="" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="سريع وبدون تسجيل دخول"
                        android:textColor="@color/white"
                        android:textSize="12.5sp"
                        android:fontFamily="@font/cairo" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_video"
                        android:contentDescription="" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="جودة عالية MP4 + استخراج MP3"
                        android:textColor="@color/white"
                        android:textSize="12.5sp"
                        android:fontFamily="@font/cairo" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Loading indicator (shown while fetching) -->
        <View
            android:id="@+id/loadingLayout"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="@color/red"
            android:visibility="gone" />

        <!-- ═══ CONTENT ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- CARD: BROWSE & DETECT (opens BrowserActivity) -->
            <LinearLayout
                android:id="@+id/browseEntryCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/card_bg"
                android:padding="14dp"
                android:layout_marginBottom="14dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌐"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="تصفح واكتشاف"
                        android:textColor="@color/grey_900"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="افتح أي موقع وسيكتشف الفيديوهات تلقائياً"
                        android:textColor="@color/grey_600"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="◀"
                    android:textColor="@color/red"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- CARD: URL INPUT -->
            <LinearLayout
                android:id="@+id/urlCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:elevation="3dp"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <!-- Section label -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_link"
                        android:contentDescription="" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="رابط الفيديو"
                        android:textColor="@color/grey_800"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/cairo" />
                </LinearLayout>

                <!-- Input + Paste -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/urlInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/edittext_bg"
                        android:padding="13dp"
                        android:hint="https://vt.tiktok.com/XXXXX/"
                        android:textColorHint="@color/grey_400"
                        android:textColor="@color/grey_900"
                        android:textSize="14sp"
                        android:textDirection="ltr"
                        android:gravity="start|center_vertical"
                        android:singleLine="true"
                        android:inputType="textUri"
                        android:fontFamily="@font/cairo" />

                    <ImageButton
                        android:id="@+id/pasteBtn"
                        android:layout_width="46dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/paste_btn_bg"
                        android:src="@drawable/ic_paste"
                        android:contentDescription="لصق"
                        android:scaleType="centerInside"
                        android:padding="10dp" />
                </LinearLayout>

                <!-- Fetch button -->
                <Button
                    android:id="@+id/fetchBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/fetch_btn_bg"
                    android:text="جلب الفيديو"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:fontFamily="@font/cairo"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:drawableStart="@drawable/ic_search"
                    android:drawablePadding="8dp" />

                <!-- Status message -->
                <TextView
                    android:id="@+id/statusMsg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:textSize="12.5sp"
                    android:textColor="@color/grey_600"
                    android:fontFamily="@font/cairo"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- CARD: RESULT -->
            <LinearLayout
                android:id="@+id/resultCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:elevation="3dp"
                android:padding="16dp"
                android:layout_marginBottom="14dp"
                android:visibility="gone">

                <!-- Thumb + Info -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/resultThumb"
                        android:layout_width="78dp"
                        android:layout_height="104dp"
                        android:background="@color/grey_200"
                        android:scaleType="centerCrop" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/resultTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textColor="@color/grey_900"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/cairo"
                            android:maxLines="3"
                            android:ellipsize="end" />

                        <!-- Stats row -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp">
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_heart"
                                android:contentDescription="" />
                            <TextView
                                android:id="@+id/statLikes"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="—"
                                android:textColor="@color/grey_600"
                                android:textSize="11.5sp"
                                android:fontFamily="@font/cairo" />
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginStart="12dp"
                                android:src="@drawable/ic_clock"
                                android:contentDescription="" />
                            <TextView
                                android:id="@+id/statDuration"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="—"
                                android:textColor="@color/grey_600"
                                android:textSize="11.5sp"
                                android:fontFamily="@font/cairo" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/grey_200"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp" />

                <!-- Download buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/dlMp4Hd"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/dl_mp4hd_bg"
                        android:padding="14dp"
                        android:clickable="true"
                        android:focusable="true">
                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_video"
                            android:contentDescription="" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="MP4 HD"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/cairo" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="بدون علامة مائية"
                            android:textColor="@color/white"
                            android:alpha="0.8"
                            android:textSize="10sp"
                            android:fontFamily="@font/cairo" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/dlMp3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/dl_mp3_bg"
                        android:padding="14dp"
                        android:clickable="true"
                        android:focusable="true">
                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_music"
                            android:contentDescription="" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="MP3"
                            android:textColor="@color/grey_800"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/cairo" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="الصوت فقط"
                            android:textColor="@color/grey_700"
                            android:alpha="0.8"
                            android:textSize="10sp"
                            android:fontFamily="@font/cairo" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- CARD: HOW-TO -->
            <LinearLayout
                android:id="@+id/howtoCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:elevation="3dp"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_help"
                        android:contentDescription="" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="طريقة الاستخدام"
                        android:textColor="@color/grey_800"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/cairo" />
                </LinearLayout>

                <!-- Step 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/howto_num_bg"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="@color/red"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/cairo" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="افتح تيك توك وانسخ رابط الفيديو (زر مشاركة — نسخ الرابط)"
                        android:textColor="@color/grey_700"
                        android:textSize="13sp"
                        android:fontFamily="@font/cairo"
                        android:lineSpacingMultiplier="1.3" />
                </LinearLayout>

                <!-- Step 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/howto_num_bg"
                        android:gravity="center"
                        android:text="2"
                        android:textColor="@color/red"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/cairo" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="الصق الرابط في الحقل أعلاه واضغط جلب الفيديو"
                        android:textColor="@color/grey_700"
                        android:textSize="13sp"
                        android:fontFamily="@font/cairo"
                        android:lineSpacingMultiplier="1.3" />
                </LinearLayout>

                <!-- Step 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/howto_num_bg"
                        android:gravity="center"
                        android:text="3"
                        android:textColor="@color/red"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/cairo" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="اختر MP4 لتنزيل الفيديو أو MP3 لتنزيل الصوت فقط"
                        android:textColor="@color/grey_700"
                        android:textSize="13sp"
                        android:fontFamily="@font/cairo"
                        android:lineSpacingMultiplier="1.3" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
