<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/grey_100">

    <!-- ═══ ADDRESS BAR ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/header_gradient"
        android:padding="10dp">

        <ImageButton
            android:id="@+id/browserBackBtn"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/hero_card_bg"
            android:src="@android:drawable/ic_media_previous"
            android:scaleType="center"
            android:contentDescription="رجوع" />

        <EditText
            android:id="@+id/browserUrlInput"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/edittext_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:hint="اكتب رابط الموقع..."
            android:textColorHint="@color/grey_400"
            android:textColor="@color/grey_900"
            android:textSize="13sp"
            android:textDirection="ltr"
            android:gravity="start|center_vertical"
            android:singleLine="true"
            android:imeOptions="actionGo"
            android:inputType="textUri" />

        <ImageButton
            android:id="@+id/browserGoBtn"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/hero_card_bg"
            android:src="@drawable/ic_search"
            android:scaleType="center"
            android:contentDescription="افتح" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/browserProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:progressTint="@color/red"
        android:visibility="gone" />

    <!-- ═══ WEBVIEW ═══ -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- ═══ DETECTED VIDEOS PANEL ═══ -->
    <LinearLayout
        android:id="@+id/detectedPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_bg"
        android:visibility="gone"
        android:elevation="8dp">

        <LinearLayout
            android:id="@+id/detectedHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎬"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/detectedCountText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="تم اكتشاف فيديو"
                android:textColor="@color/grey_900"
                android:textStyle="bold"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/detectedToggleArrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▲"
                android:textColor="@color/red"
                android:textSize="12sp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/detectedListScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="220dp">

            <LinearLayout
                android:id="@+id/detectedListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp" />
        </ScrollView>
    </LinearLayout>

</LinearLayout>
